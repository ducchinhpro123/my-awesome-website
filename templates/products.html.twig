{% extends 'base.html.twig'%}
{% set active_page = 'products' %}

{% block title %} VietShop - Danh Sách Sản Phẩm {% endblock %}

{% block body %}
    <!-- Page Header -->
    <section class="bg-light py-5 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h1 style="color: var(--dark-color);" class="display-5 fw-bold mb-3 text-red">Sản Phẩm</h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="index.html">Trang Chủ</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Sản Phẩm</li>
                        </ol>
                    </nav>
                </div>
            </div>

        {% if searchTerm is defined %}
            <h2 class='text-black text-muted'>Kết quả tìm kiếm cho từ khóa: <i>{{ searchTerm }}</i> </h2>
        {% endif %}
        </div>
    </section>

    <!-- Products Section -->
    <section class="">
        <div class="container">
            <div class="row">
                <!-- Sidebar Filters -->
                <div class="col-lg-3 mb-4">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0 text-white">Bộ Lọc</h5>
                        </div>
                        <form class="card-body" method="get" id='form-filter'>
                            <input type='hidden' name='action' value='products-filter'/>
                            <!-- Categories -->
                            <div class="mb-4">
                                <h6 class="fw-bold text-red">Danh Mục</h6>
                                {% for category in categories %}
                                    <div class="form-check">

                                        <input class="form-check-input" name="categories[]"
                                        {{ category.name in categories_filter or category.name == category_filter ? 'checked' : '' }}

                                        type="checkbox" value="{{ category.name }}" id="{{ category.name }}" />
                                        <label class="form-check-label" for="{{ category.name }}">{{ category.name }}</label>
                                    </div>
                                {% endfor %}
                            </div>

                            <!-- Price Range -->
                            <div class="mb-4 mx-3">
                                <h6 class="fw-bold text-red">Tầm Giá</h6>
                                {% for price in prices %}
                                    <div class="form-check">
                                        <input class="form-check-input" {{ price.value in prices_filter ? 'checked' : '' }}
                                               type="checkbox" name="prices[]" value="{{ price.value }}" 
                                                                                                        id="{{ price.value }}">
                                        <label class="form-check-label" for="{{ price.value }}">{{ price.label }}</label>
                                    </div>
                                {% endfor %}
                            </div>

                            <!-- Rating -->
                            <div class="mb-4 mx-3">
                                <h6 class="fw-bold text-red">Mức Độ Đánh Giá</h6>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="5" id="rating5">
                                    <label class="form-check-label" for="rating5">
                                        <span class="text-warning">★★★★★</span> 5 Stars
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="4" id="rating4">
                                    <label class="form-check-label" for="rating4">
                                        <span class="text-warning">★★★★☆</span> 4+ Stars
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="3" id="rating3">
                                    <label class="form-check-label" for="rating3">
                                        <span class="text-warning">★★★☆☆</span> 3+ Stars
                                    </label>
                                </div>
                            </div>

                            <button class="btn btn-red w-100 mb-2">Áp Dụng Bộ Lọc</button>
                            <button type="button" class="btn btn-outline-red w-100" onclick="clearAllFilters()">Xóa Tất Cả</button>
                        </form>
                    </div>

                </div>

                <div class="col-lg-9">
                    <!-- Sort and View Options -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <span class="text-muted">Hiển thị {{ pagination.startNumberItemDisplay }}-{{ pagination.endNumberItemDisplay }}
                                trong tổng số {{ totalItemsNumber }} sản phẩm</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <input type='hidden' name='action' value='products-filter'/>
                            <select id="sort-by-select" class="form-select form-select-sm" style="width: auto;" name='sort_by'>
                                {% for order in orderBy %}
                                    <option {{ order.value == sort_by_filter ? 'selected' : '' }} value="{{ order.value }}">{{ order.label }}</option>
                                {% endfor %}
                            </select>
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-outline-secondary btn-sm active">
                                    <i class="fas fa-th"></i>
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-list"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Products Grid -->
                    <div class="row" id="products-grid">
                        {% for product in products %}
                        <div class="col-lg-4 col-md-6 mb-4">
                            <div class="card product-card h-100 shadow-sm">
                                <div class="position-relative">
                                    <img src="{{ product.imageUrl }}" 
                                         class="card-img-top" alt="Wireless Headphones">
                                    <span class="badge bg-danger position-absolute top-0 end-0 m-2">Sale</span>
                                    <div class="product-overlay">
                                        <a class="btn btn-light btn-sm wishlist-btn">
                                            <i class="far fa-heart"></i>
                                        </a>
                                    </div>
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">{{ product.name }} {{ product.id }}</h5>
                                    <p class="card-text text-muted">{{ product.description }}</p>
                                    <div class="mt-auto">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="h5 mb-0 text-primary">{{ product.price|number_format(0, ',', '.') }} ₫</span>
                                            <span class="text-muted text-decoration-line-through">$129.99</span>
                                        </div>
                                        <div class="text-warning mb-2">
                                            {% if product.rating > 0 %}
                                                {% for i in 1..product.rating %}
                                                    <i class="fas fa-star"></i>
                                                {% endfor %}
                                            {% endif %}
                                            {% if product.rating != 5 %}
                                                {% for i in range(product.rating, 4) %}
                                                    <i class="far fa-star"></i>
                                                {% endfor %}
                                            {% endif %}

                                            <span class="text-muted ms-1">(24)</span>
                                        </div>
                                        {# <div class="text-warning mb-2"> #}
                                        {#     <i class="fas fa-star"></i> #}
                                        {#     <i class="fas fa-star"></i> #}
                                        {#     <i class="fas fa-star"></i> #}
                                        {#     <i class="fas fa-star"></i> #}
                                        {#     <i class="far fa-star"></i> #}
                                        {#     <span class="text-muted ms-1">(24)</span> #}
                                        {# </div> #}
                                        <div class="d-flex justify-content-between">
                                            <a href="/?action=add-to-cart&product_id={{ product.id }}" class="btn btn-primary btn-sm add-to-cart" data-product-id="1">
                                                <i class="fas fa-cart-plus me-1"></i>Add to Cart
                                            </a>
                                            <a href="/?action=product-detail&id={{ product.id }}" class="btn btn-outline-primary btn-sm">
                                                <i class="fas fa-eye me-1"></i>View
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% else %}
                            <div class="col-12">
                                <div class="alert alert-info text-center" role="alert">
                                    Không có sản phẩm nào trong danh mục này.
                                </div>
                            </div>
                        {% endfor %}
                        <!-- Product 1 -->
                        <!-- Product 2 -->
                        {# <div class="col-lg-4 col-md-6 mb-4"> #}
                        {#     <div class="card product-card h-100 shadow-sm"> #}
                        {#         <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" #} 
                        {#              class="card-img-top" alt="Smart Watch"> #}
                        {#         <div class="card-body d-flex flex-column"> #}
                        {#             <h5 class="card-title">Smart Watch</h5> #}
                        {#             <p class="card-text text-muted">Track your fitness and stay connected with this smart watch</p> #}
                        {#             <div class="mt-auto"> #}
                        {#                 <div class="d-flex justify-content-between align-items-center mb-2"> #}
                        {#                     <span class="h5 mb-0 text-primary">$199.99</span> #}
                        {#                 </div> #}
                        {#                 <div class="text-warning mb-2"> #}
                        {#                     <i class="fas fa-star"></i> #}
                        {#                     <i class="fas fa-star"></i> #}
                        {#                     <i class="fas fa-star"></i> #}
                        {#                     <i class="fas fa-star"></i> #}
                        {#                     <i class="fas fa-star"></i> #}
                        {#                     <span class="text-muted ms-1">(18)</span> #}
                        {#                 </div> #}
                        {#                 <div class="d-flex justify-content-between"> #}
                        {#                     <button class="btn btn-primary btn-sm add-to-cart" data-product-id="2"> #}
                        {#                         <i class="fas fa-cart-plus me-1"></i>Add to Cart #}
                        {#                     </button> #}
                        {#                     <a href="product-detail.html?id=2" class="btn btn-outline-primary btn-sm"> #}
                        {#                         <i class="fas fa-eye me-1"></i>View #}
                        {#                     </a> #}
                        {#                 </div> #}
                        {#             </div> #}
                        {#         </div> #}
                        {#     </div> #}
                        {# </div> #}

                        <!-- Product 3 -->


                        <!-- Product 6 -->
                    </div>

                    <!-- Pagination -->
                    {% if products|length != 0 %}
                        <nav aria-label="Products pagination">
                            <ul class="pagination justify-content-center">
                                {% if products_filter %}
                                    <li class="page-item {{ pagination.has_previous ? '' : 'disabled' }}">
                                        <a class="page-link" href="{{ current_url }}&page={{ pagination.current_page - 1 }}" tabindex="-1">Previous</a>
                                    </li>
                                    {% for page_num in 0..pagination.totalPages - 1 %}
                                        <li class="page-item {{ page_num == pagination.current_page ? 'active' : '' }}">
                                            <a class="page-link" href="{{ current_url }}&page={{ page_num}}">{{ page_num + 1 }}</a>
                                        </li>
                                    {% endfor %}
                                    <li class="page-item {{ pagination.has_next ? '' : 'disabled' }}">
                                        <a class="page-link" href="{{ current_url }}&page={{ pagination.current_page + 1 }}">Next</a>
                                    </li>
                                {% elseif pagination.totalPages > 1 %}
                                    <li class="page-item {{ pagination.has_previous ? '' : 'disabled' }}">
                                        <a class="page-link" href="?action=products&page={{ pagination.current_page - 1 }}" tabindex="-1">Previous</a>
                                    </li>
                                    {% for page_num in 0..pagination.totalPages - 1 %}
                                        <li class="page-item {{ page_num == pagination.current_page ? 'active' : '' }}">
                                            <a class="page-link" href="/?action=products&page={{ page_num}}">{{ page_num + 1 }}</a>
                                        </li>
                                    {% endfor %}
                                    <li class="page-item {{ pagination.has_next ? '' : 'disabled' }}">
                                        <a class="page-link" href="?action=products&page={{ pagination.current_page + 1 }}">Next</a>
                                    </li>
                                {% endif %}

                            </ul>
                        </nav>
                    {% endif %}
                </div>

            </div>
        </div>
    </section>
    <script>
        const filterForm = document.getElementById('form-filter');
        const sortBySelect = document.getElementById('sort-by-select');
        const searchForm = document.getElementById('search-form');

        function syncAndSubmit() {
            const formData = new FormData(filterForm);
            const params = new URLSearchParams(formData);
            if (sortBySelect.value) {
                params.set('sort_by', sortBySelect.value);
            }
            params.set('action', 'products-filter');
            const searchInput = searchForm.querySelector('input[name="query"]');
            if (searchInput && searchInput.value) {
                params.set('query', searchInput.value);
            }

            const newUrl = window.location.pathname + '?' + params.toString();
            window.location.href = newUrl;
        }

        filterForm.addEventListener('submit', function(event) {
            event.preventDefault();
            syncAndSubmit();
        });

        sortBySelect.addEventListener('change', function() {
            syncAndSubmit();
        });

        function clearAllFilters() {
            const filterForm = document.getElementById('form-filter');
            if (filterForm) {
                const checkboxes = filterForm.querySelectorAll('input[type="checkbox"]');
                checkboxes.forEach(checkbox => {
                    checkbox.checked = false;
                });
                window.location.href='/?action=products';
            }
        }
    </script>

{% endblock %}
