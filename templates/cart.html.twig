{% extends 'base.html.twig'%}

{% set active_page = 'cart' %}

{% block title %} Giỏ hàng {% endblock %}

{% block body %} 
    <!-- Page Header -->
    <section class="bg-light py-5 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h1 class="display-5 fw-bold mb-3 text-red">Giỏ Hàng</h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/?action=home">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Giỏ Hàng</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </section>

    <!-- Cart Section -->
    <section class="">
        <div class="container">
            <div class="row">
                <!-- Cart Items -->
                <div class="col-lg-8 mb-4">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">Cart Items (3)</h5>
                        </div>
                        <div class="card-body p-0">
                            {% for cartItem in cartItems %}
                                <div class="cart-item border-bottom p-4">
                                    <div class="row align-items-center">
                                        <div class="col-md-2">
                                            <img src="{{cartItem.product.imageUrl }}"
                                                 class="img-fluid rounded" alt="Wireless Headphones">
                                        </div>
                                        <div class="col-md-4">
                                            <h6 class="mb-1"> {{ cartItem.product.name }} </h6>
                                            <p class="text-muted mb-1">Color: Black</p>
                                            <small class="text-success">In Stock</small>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="input-group">
                                                <button class="btn btn-outline-secondary btn-sm" type="button">-</button>
                                                    <input type="number" class="form-control form-control-sm text-center" value="{{ cartItem.quantity }}" min="1">
                                                <button class="btn btn-outline-secondary btn-sm" type="button">+</button>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="text-center">
                                                <span class="h6 text-primary">{{ cartItem.product.price }}</span>
                                                <div class="text-muted text-decoration-line-through small">$129.99</div>
                                            </div>
                                        </div>
                                        <div class="col-md-2 text-center">
                                            <button class="btn btn-outline-danger btn-sm">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                            <button class="btn btn-outline-secondary btn-sm ms-1">
                                                <i class="far fa-heart"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                {% else %}
                                    <div class="d-flex flex-column align-items-center justify-content-center p-5 bg-light rounded-3 m-4">
                                        <i class="fas fa-dolly-flatbed fa-3x text-secondary mb-4"></i>
                                        <h5 class="mb-3">
                                            Giỏ hàng của bạn đang chờ!
                                        </h5>
                                        <p class="text-center text-muted mb-4">
                                            Hãy lấp đầy với những sản phẩm tuyệt vời. Hành trình mua sắm tuyệt vời của bạn bắt đầu tại đây.
                                        </p>
                                        <a href="/?action=products" class="btn btn-outline-primary">
                                            <i class="fas fa-search me-2"></i>Lướt Sắm
                                        </a>
                                    </div>
                            {% endfor %}


                        </div>
                        <div class="card-footer">
                            <div class="d-flex justify-content-between">
                                <a href="/?action=products" class="btn btn-outline-primary">
                                    <i class="fas fa-arrow-left me-2"></i>Tiếp tục mua sắm
                                </a>
                                <button class="btn btn-outline-secondary">
                                    <i class="fas fa-sync me-2"></i>Update Cart
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Order Summary -->
                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">Order Summary</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal (4 items):</span>
                                <span>$459.97</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Shipping:</span>
                                <span class="text-success">Free</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Tax:</span>
                                <span>$36.80</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Discount:</span>
                                <span class="text-success">-$30.00</span>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between mb-3">
                                <strong>Total:</strong>
                                <strong class="text-primary">$466.77</strong>
                            </div>
                            
                            <!-- Promo Code -->
                            <div class="mb-3">
                                <label for="promoCode" class="form-label">Promo Code</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="promoCode" placeholder="Enter code">
                                    <button class="btn btn-outline-secondary" type="button">Apply</button>
                                </div>
                            </div>

                            <button class="btn btn-primary w-100 mb-3">
                                <i class="fas fa-lock me-2"></i>Proceed to Checkout
                            </button>
                            
                            <div class="text-center">
                                <small class="text-muted">
                                    <i class="fas fa-shield-alt me-1"></i>
                                    Secure checkout with SSL encryption
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- Shipping Info -->
                    <div class="card mt-4">
                        <div class="card-header">
                            <h6 class="mb-0">Shipping Information</h6>
                        </div>
                        <div class="card-body">
                            <ul class="list-unstyled mb-0">
                                <li class="mb-2">
                                    <i class="fas fa-truck text-primary me-2"></i>
                                    Free shipping on orders over $50
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-clock text-primary me-2"></i>
                                    Estimated delivery: 3-5 business days
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-undo text-primary me-2"></i>
                                    30-day return policy
                                </li>
                                <li>
                                    <i class="fas fa-headset text-primary me-2"></i>
                                    24/7 customer support
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Payment Methods -->
                    <div class="card mt-4">
                        <div class="card-header">
                            <h6 class="mb-0 text-white">We Accept</h6>
                        </div>
                        <div class="card-body text-center">

                            <img class="me-2 mb-2" style="height: 50px;" src="/assets/icons/visa-svgrepo-com.png" alt="Visa">
                            <img class="me-2 mb-2" style="height: 50px;" src="/assets/icons/mastercard-full-svgrepo-com.png" alt="Mastercard">
                            <img style="height: 50px;" src="/assets/icons/paypal-svgrepo-com.png" alt="PayPal">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Recently Viewed -->
    <section class="py-5 bg-light">
        <div class="container">
            <h4 class="mb-4">Recently Viewed</h4>
            <div class="row">
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="card product-card h-100 shadow-sm">
                        <img src="https://images.unsplash.com/photo-1586953208448-b95a79798f07?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" 
                             class="card-img-top" alt="Gaming Laptop">
                        <div class="card-body">
                            <h6 class="card-title">Gaming Laptop</h6>
                            <div class="text-primary fw-bold">$899.99</div>
                            <button class="btn btn-primary btn-sm mt-2 w-100">
                                <i class="fas fa-cart-plus me-1"></i>Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="card product-card h-100 shadow-sm">
                        <img src="https://images.unsplash.com/photo-1572635196237-14b3f281503f?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" 
                             class="card-img-top" alt="Sunglasses">
                        <div class="card-body">
                            <h6 class="card-title">Designer Sunglasses</h6>
                            <div class="text-primary fw-bold">$49.99</div>
                            <button class="btn btn-primary btn-sm mt-2 w-100">
                                <i class="fas fa-cart-plus me-1"></i>Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="card product-card h-100 shadow-sm">
                        <img src="https://images.unsplash.com/photo-1560472354-b33ff0c44a43?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" 
                             class="card-img-top" alt="Backpack">
                        <div class="card-body">
                            <h6 class="card-title">Travel Backpack</h6>
                            <div class="text-primary fw-bold">$69.99</div>
                            <button class="btn btn-primary btn-sm mt-2 w-100">
                                <i class="fas fa-cart-plus me-1"></i>Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="card product-card h-100 shadow-sm">
                        <img src="https://images.unsplash.com/photo-1484704849700-f032a568e944?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" 
                             class="card-img-top" alt="Bluetooth Speaker">
                        <div class="card-body">
                            <h6 class="card-title">Bluetooth Speaker</h6>
                            <div class="text-primary fw-bold">$39.99</div>
                            <button class="btn btn-primary btn-sm mt-2 w-100">
                                <i class="fas fa-cart-plus me-1"></i>Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
