{% extends 'admin/base.html.twig' %}

{% block title %}Users Management{% endblock %}

{% block content %}
<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 fw-bold">Users Management</h4>
        <p class="text-secondary mb-0">Total: {{ total_users }} users</p>
    </div>
    <div>
        <form class="d-flex gap-2" method="GET" action="/?action=admin-users">
            <input type="hidden" name="action" value="admin-users">
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0 ps-0" name="search" placeholder="Search users..." 
                       value="{{ search }}" style="width: 250px;">
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
            {% if search %}
                <a href="/?action=admin-users" class="btn btn-light border shadow-sm" title="Clear Search">
                    <i class="fas fa-times"></i>
                </a>
            {% endif %}
        </form>
    </div>
</div>

<!-- Users Table -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">User</th>
                        <th>Role</th>
                        <th>Contact</th>
                        <th>Joined Date</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="position-relative">
                                    <img src="{{ user.avatar ?: 'https://ui-avatars.com/api/?name=' ~ user.fullName|url_encode ~ '&background=random' }}" 
                                         class="rounded-circle me-3 border" width="48" height="48" style="object-fit: cover;">
                                    {% if user.isAdmin %}
                                        <span class="position-absolute bottom-0 end-0 bg-primary border border-white rounded-circle p-1" style="width: 16px; height: 16px; margin-right: 12px;"></span>
                                    {% endif %}
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">{{ user.fullName }}</div>
                                    <div class="text-secondary small">@{{ user.username }}</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            {% if user.isAdmin %}
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3">
                                    <i class="fas fa-shield-alt me-1"></i>Admin
                                </span>
                            {% else %}
                                <span class="badge bg-light text-secondary border rounded-pill px-3">
                                    <i class="fas fa-user me-1"></i>User
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="d-flex flex-column">
                                <span class="text-dark mb-1"><i class="fas fa-envelope text-muted me-2 small"></i>{{ user.email ?: 'No email' }}</span>
                                <span class="text-secondary small"><i class="fas fa-phone text-muted me-2 small"></i>{{ user.phoneNumber ?: 'No phone' }}</span>
                            </div>
                        </td>
                        <td>
                            <div class="text-secondary">
                                <i class="far fa-calendar-alt me-1 text-muted"></i>
                                {{ user.createdAt|date('M d, Y') }}
                            </div>
                            <small class="text-muted">{{ user.createdAt|date('H:i') }}</small>
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex justify-content-end gap-2">
                                <!-- Change Role Button -->
                                {% if user.id != admin.id %}
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light text-dark dropdown-toggle" 
                                            type="button" data-bs-toggle="dropdown" title="Change Role">
                                        <i class="fas fa-user-cog"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                        <li><h6 class="dropdown-header">Change Role</h6></li>
                                        <li>
                                            <form action="/?action=admin-update-role" method="POST">
                                                <input type="hidden" name="user_id" value="{{ user.id }}">
                                                <input type="hidden" name="role" value="ROLE_USER">
                                                <button type="submit" class="dropdown-item d-flex align-items-center justify-content-between {% if not user.isAdmin %}active{% endif %}">
                                                    <span><i class="fas fa-user me-2 text-secondary"></i>User</span>
                                                    {% if not user.isAdmin %}<i class="fas fa-check small"></i>{% endif %}
                                                </button>
                                            </form>
                                        </li>
                                        <li>
                                            <form action="/?action=admin-update-role" method="POST">
                                                <input type="hidden" name="user_id" value="{{ user.id }}">
                                                <input type="hidden" name="role" value="ROLE_ADMIN">
                                                <button type="submit" class="dropdown-item d-flex align-items-center justify-content-between {% if user.isAdmin %}active{% endif %}">
                                                    <span><i class="fas fa-shield-alt me-2 text-primary"></i>Admin</span>
                                                    {% if user.isAdmin %}<i class="fas fa-check small"></i>{% endif %}
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>

                                <!-- Delete Button -->
                                <button type="button" class="btn btn-sm btn-light text-danger" 
                                        data-bs-toggle="modal" data-bs-target="#deleteModal{{ user.id }}" title="Delete User">
                                    <i class="fas fa-trash"></i>
                                </button>

                                <!-- Delete Modal -->
                                <div class="modal fade" id="deleteModal{{ user.id }}" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow">
                                            <div class="modal-header border-bottom-0 pb-0">
                                                <h5 class="modal-title text-danger fw-bold">
                                                    <i class="fas fa-user-times me-2"></i>Delete User
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body pt-4 text-start">
                                                <p class="text-secondary">Are you sure you want to delete this user? This action cannot be undone.</p>
                                                <div class="d-flex align-items-center p-3 bg-light rounded-3 border">
                                                    <img src="{{ user.avatar ?: 'https://ui-avatars.com/api/?name=' ~ user.fullName|url_encode }}" 
                                                         class="rounded-circle me-3" width="48" height="48">
                                                    <div>
                                                        <div class="fw-bold text-dark">{{ user.fullName }}</div>
                                                        <div class="text-secondary small">@{{ user.username }}</div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer border-top-0">
                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                <form action="/?action=admin-delete-user" method="POST" class="d-inline">
                                                    <input type="hidden" name="user_id" value="{{ user.id }}">
                                                    <button type="submit" class="btn btn-danger">
                                                        <i class="fas fa-trash me-2"></i>Delete User
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                {% else %}
                                <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3 py-2">
                                    Current User
                                </span>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <div class="mb-3">
                                <i class="fas fa-users fa-3x text-secondary opacity-25"></i>
                            </div>
                            <h6 class="text-secondary fw-bold">No users found</h6>
                            <p class="text-muted small mb-0">Try adjusting your search criteria.</p>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pagination -->
{% if total_users > 20 %}
<nav class="mt-5">
    <ul class="pagination justify-content-center">
        {% if current_page > 0 %}
            <li class="page-item">
                <a class="page-link" href="/?action=admin-users&page={{ current_page - 1 }}">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>
        {% endif %}
        
        {% set total_pages = (total_users / 20)|round(0, 'ceil') %}
        {% for i in 0..total_pages - 1 %}
            <li class="page-item {% if i == current_page %}active{% endif %}">
                <a class="page-link" href="/?action=admin-users&page={{ i }}">{{ i + 1 }}</a>
            </li>
        {% endfor %}
        
        {% if current_page < total_pages - 1 %}
            <li class="page-item">
                <a class="page-link" href="/?action=admin-users&page={{ current_page + 1 }}">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
        {% endif %}
    </ul>
</nav>
{% endif %}
{% endblock %}
