{% extends 'admin/base.html.twig' %}

{% block title %}Products Management{% endblock %}

{% block content %}
<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 fw-bold">Products Management</h4>
        <p class="text-secondary mb-0">Total: {{ total_products }} products</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#addProductModal">
            <i class="fas fa-plus me-2"></i>Add Product
        </button>
    </div>
</div>

<!-- Products Grid -->
<div class="row g-4">
    {% for product in products %}
    <div class="col-xl-3 col-lg-4 col-md-6">
        <div class="card h-100 border-0 shadow-sm hover-shadow transition-all">
            <div class="position-relative">
                <img src="{{ product.imageUrl ?? 'https://via.placeholder.com/300x200?text=No+Image' }}" 
                     class="card-img-top" alt="{{ product.name }}"
                     style="height: 200px; object-fit: cover;">
                <div class="position-absolute top-0 end-0 m-3">
                    <span class="badge bg-white text-primary shadow-sm">{{ product.price|number_format(0, '.', ',') }}₫</span>
                </div>
                <div class="position-absolute top-0 start-0 m-3">
                    <span class="badge bg-{{ product.stock > 0 ? 'success' : 'danger' }} shadow-sm">
                        {{ product.stock > 0 ? 'In Stock: ' ~ product.stock : 'Out of Stock' }}
                    </span>
                </div>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="badge bg-light text-secondary border">{{ product.category.name ?? 'Uncategorized' }}</span>
                    <div class="d-flex align-items-center">
                        <i class="fas fa-star text-warning small me-1"></i>
                        <span class="small fw-bold">{{ product.rating }}</span>
                    </div>
                </div>
                <h6 class="card-title fw-bold mb-2 text-truncate" title="{{ product.name }}">{{ product.name }}</h6>
                <p class="card-text small text-secondary mb-3" style="height: 40px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                    {{ product.description }}
                </p>
            </div>
            <div class="card-footer bg-transparent border-top-0 pt-0 pb-3">
                <div class="d-flex gap-2">
                    <a href="/?action=product-detail&id={{ product.id }}" class="btn btn-sm btn-light text-primary flex-grow-1" target="_blank" title="View on Site">
                        <i class="fas fa-external-link-alt"></i>
                    </a>
                    <button type="button" class="btn btn-sm btn-light text-info flex-grow-1" data-bs-toggle="modal" data-bs-target="#editProductModal{{ product.id }}" title="Edit">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-light text-danger flex-grow-1" data-bs-toggle="modal" data-bs-target="#deleteProductModal{{ product.id }}" title="Delete">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Product Modal for this product -->
    <div class="modal fade" id="editProductModal{{ product.id }}" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <form action="/?action=admin-edit-product" method="POST" enctype="multipart/form-data">
                    <input type="hidden" name="product_id" value="{{ product.id }}">
                    <div class="modal-header border-bottom-0 pb-0">
                        <h5 class="modal-title fw-bold">Edit Product</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body pt-4">
                        <div class="row g-4">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label for="edit_name_{{ product.id }}" class="form-label small fw-bold text-secondary">PRODUCT NAME <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="edit_name_{{ product.id }}" name="name" value="{{ product.name }}" required>
                                </div>
                                
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="edit_price_{{ product.id }}" class="form-label small fw-bold text-secondary">PRICE (₫) <span class="text-danger">*</span></label>
                                        <input type="number" class="form-control" id="edit_price_{{ product.id }}" name="price" value="{{ product.price }}" min="0" step="1000" required>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="edit_stock_{{ product.id }}" class="form-label small fw-bold text-secondary">STOCK</label>
                                        <input type="number" class="form-control" id="edit_stock_{{ product.id }}" name="stock" value="{{ product.stock }}" min="0">
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="edit_category_{{ product.id }}" class="form-label small fw-bold text-secondary">CATEGORY <span class="text-danger">*</span></label>
                                        <select class="form-select" id="edit_category_{{ product.id }}" name="category_id" required>
                                            <option value="">Select category...</option>
                                            {% for category in categories %}
                                                <option value="{{ category.id }}" {% if product.category and product.category.id == category.id %}selected{% endif %}>
                                                    {{ category.name }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="edit_rating_{{ product.id }}" class="form-label small fw-bold text-secondary">RATING (0-5)</label>
                                        <input type="number" class="form-control" id="edit_rating_{{ product.id }}" name="rating" value="{{ product.rating }}" min="0" max="5">
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="edit_description_{{ product.id }}" class="form-label small fw-bold text-secondary">DESCRIPTION</label>
                                    <textarea class="form-control" id="edit_description_{{ product.id }}" name="description" rows="4">{{ product.description }}</textarea>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-secondary">CURRENT IMAGE</label>
                                    <div class="border rounded p-2 text-center mb-3 bg-light">
                                        <img src="{{ product.imageUrl ?? 'https://via.placeholder.com/200x150?text=No+Image' }}" 
                                             class="img-fluid rounded shadow-sm" style="max-height: 150px;">
                                    </div>
                                    <label for="edit_image_{{ product.id }}" class="form-label small fw-bold text-secondary">UPLOAD NEW IMAGE</label>
                                    <input type="file" class="form-control" id="edit_image_{{ product.id }}" name="image" accept="image/*">
                                    <small class="text-muted d-block mt-1">Leave empty to keep current image</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-top-0">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Delete Product Confirmation Modal -->
    <div class="modal fade" id="deleteProductModal{{ product.id }}" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title text-danger fw-bold">
                        <i class="fas fa-exclamation-triangle me-2"></i>Delete Product
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-4">
                    <p class="text-secondary">Are you sure you want to delete this product? This action cannot be undone.</p>
                    <div class="d-flex align-items-center p-3 bg-light rounded-3 border">
                        <img src="{{ product.imageUrl ?? 'https://via.placeholder.com/60x60?text=No+Image' }}" 
                             class="rounded me-3" width="60" height="60" style="object-fit: cover;">
                        <div>
                            <div class="fw-bold text-dark">{{ product.name }}</div>
                            <div class="text-primary fw-bold">{{ product.price|number_format(0, '.', ',') }}₫</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <form action="/?action=admin-delete-product" method="POST" class="d-inline">
                        <input type="hidden" name="product_id" value="{{ product.id }}">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-2"></i>Delete Product
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    {% else %}
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div class="mb-3">
                    <i class="fas fa-box-open fa-3x text-secondary opacity-25"></i>
                </div>
                <h5 class="text-secondary fw-bold">No products found</h5>
                <p class="text-muted mb-4">Get started by adding your first product to the store.</p>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addProductModal">
                    <i class="fas fa-plus me-2"></i>Add Your First Product
                </button>
            </div>
        </div>
    </div>
    {% endfor %}
</div>

<!-- Pagination -->
{% if total_products > 12 %}
<nav class="mt-5">
    <ul class="pagination justify-content-center">
        {% if current_page > 0 %}
            <li class="page-item">
                <a class="page-link" href="/?action=admin-products&page={{ current_page - 1 }}">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>
        {% endif %}
        
        {% set total_pages = (total_products / 12)|round(0, 'ceil') %}
        {% for i in 0..total_pages - 1 %}
            <li class="page-item {% if i == current_page %}active{% endif %}">
                <a class="page-link" href="/?action=admin-products&page={{ i }}">{{ i + 1 }}</a>
            </li>
        {% endfor %}
        
        {% if current_page < total_pages - 1 %}
            <li class="page-item">
                <a class="page-link" href="/?action=admin-products&page={{ current_page + 1 }}">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
        {% endif %}
    </ul>
</nav>
{% endif %}

<!-- Add Product Modal -->
<div class="modal fade" id="addProductModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form action="/?action=admin-add-product" method="POST" enctype="multipart/form-data">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold">
                        <i class="fas fa-plus-circle me-2 text-primary"></i>Add New Product
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-4">
                    <div class="row g-4">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label for="add_name" class="form-label small fw-bold text-secondary">PRODUCT NAME <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="add_name" name="name" placeholder="Enter product name" required>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="add_price" class="form-label small fw-bold text-secondary">PRICE (₫) <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control" id="add_price" name="price" placeholder="0" min="0" step="1000" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="add_stock" class="form-label small fw-bold text-secondary">STOCK</label>
                                    <input type="number" class="form-control" id="add_stock" name="stock" placeholder="0" min="0" value="0">
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="add_category" class="form-label small fw-bold text-secondary">CATEGORY <span class="text-danger">*</span></label>
                                    <select class="form-select" id="add_category" name="category_id" required>
                                        <option value="">Select category...</option>
                                        {% for category in categories %}
                                            <option value="{{ category.id }}">{{ category.name }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="add_rating" class="form-label small fw-bold text-secondary">RATING (0-5)</label>
                                    <input type="number" class="form-control" id="add_rating" name="rating" placeholder="0" min="0" max="5" value="0">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="add_description" class="form-label small fw-bold text-secondary">DESCRIPTION</label>
                                <textarea class="form-control" id="add_description" name="description" rows="4" placeholder="Enter product description..."></textarea>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="add_image" class="form-label small fw-bold text-secondary">PRODUCT IMAGE</label>
                                <div class="border rounded p-4 text-center mb-3 bg-light" id="imagePreviewContainer">
                                    <i class="fas fa-image fa-3x text-secondary opacity-25 mb-2"></i>
                                    <p class="text-muted small mb-0">No image selected</p>
                                </div>
                                <input type="file" class="form-control" id="add_image" name="image" accept="image/*" onchange="previewImage(this)">
                                <small class="text-muted d-block mt-1">Supported: JPG, PNG, GIF (Max 5MB)</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Add Product
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function previewImage(input) {
    const container = document.getElementById('imagePreviewContainer');
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            container.innerHTML = '<img src="' + e.target.result + '" class="img-fluid rounded shadow-sm" style="max-height: 150px;">';
            container.classList.remove('p-4');
            container.classList.add('p-2');
        }
        reader.readAsDataURL(input.files[0]);
    }
}
</script>
{% endblock %}
