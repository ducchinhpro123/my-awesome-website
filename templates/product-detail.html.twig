{% extends 'base.html.twig'%}
{% block body %}

    <!-- Breadcrumb -->
    <section class="bg-light py-3" style="margin-top: 90px">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="index.html">Home</a></li>
                    <li class="breadcrumb-item"><a href="products.html">Products</a></li>
                    <li class="breadcrumb-item"><a href="/?action=products-filter&category={{ product.category.name|url_encode }}">
                        {{ product.category.name }}</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">{{ product.name }}</li>
                </ol>
            </nav>
        </div>
    </section>

    <!-- Product Detail Section -->
    <section class="py-5">
        <div class="container">
            <div class="row">
                <!-- Product Images -->
                <div class="col-lg-6 mb-4">
                    <div class="product-images">
                        <div class="main-image mb-3">
                            <img src="{{ product.imageUrl }}" 
                                 class="img-fluid rounded shadow" alt="Wireless Headphones" id="main-product-image">
                            <span class="badge bg-danger position-absolute top-0 end-0 m-3">Sale</span>
                        </div>
                        <div class="thumbnail-images">
                            <div class="row">
                                <div class="col-3">
                                    <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?ixlib=rb-4.0.3&auto=format&fit=crop&w=150&q=80" 
                                         class="img-fluid rounded border thumbnail-img active" alt="View 1">
                                </div>
                                <div class="col-3">
                                    <img src="https://images.unsplash.com/photo-1484704849700-f032a568e944?ixlib=rb-4.0.3&auto=format&fit=crop&w=150&q=80" 
                                         class="img-fluid rounded border thumbnail-img" alt="View 2">
                                </div>
                                <div class="col-3">
                                    <img src="https://images.unsplash.com/photo-1583394838336-acd977736f90?ixlib=rb-4.0.3&auto=format&fit=crop&w=150&q=80" 
                                         class="img-fluid rounded border thumbnail-img" alt="View 3">
                                </div>
                                <div class="col-3">
                                    <img src="https://images.unsplash.com/photo-1546435770-a3e426bf472b?ixlib=rb-4.0.3&auto=format&fit=crop&w=150&q=80" 
                                         class="img-fluid rounded border thumbnail-img" alt="View 4">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product Info -->
                <div class="col-lg-6">
                    <div class="product-info">
                        <h1 class="h2 mb-3 text-muted">{{ product.name }}</h1>
                        
                        <!-- Rating -->
                        <div class="d-flex align-items-center mb-3">
                            <div class="text-warning me-2">
                                {% if product.rating > 0 %}
                                    {% for i in 1..product.rating %}
                                        <i class="fas fa-star"></i>
                                    {% endfor %}
                                {% endif %}
                                {% if product.rating != 5 %}
                                    {% for i in range(product.rating, 4) %}
                                        <i class="far fa-star"></i>
                                    {% endfor %}
                                {% endif %}
                            </div>
                            <span class="text-muted">(24 reviews)</span>
                            <a href="#reviews" class="ms-2 text-decoration-none">Write a review</a>
                        </div>

                        <!-- Price -->
                        <div class="price-section mb-4">
                            <span class="h3 text-primary me-3">$99.99</span>
                            <span class="h5 text-muted text-decoration-line-through">$129.99</span>
                            <span class="badge bg-success ms-2">23% OFF</span>
                        </div>

                        <!-- Product Description -->
                        <div class="product-description mb-4 text-muted">
                            <p class="lead">{{ product.description }}</p>
                            <ul class="list-unstyled">
                                <li><i class="fas fa-check text-success me-2"></i>Active Noise Cancellation</li>
                                <li><i class="fas fa-check text-success me-2"></i>30-hour Battery Life</li>
                                <li><i class="fas fa-check text-success me-2"></i>Bluetooth 5.0 Connectivity</li>
                                <li><i class="fas fa-check text-success me-2"></i>Quick Charge Technology</li>
                                <li><i class="fas fa-check text-success me-2"></i>Premium Comfort Padding</li>
                            </ul>
                        </div>

                        <!-- Product Options -->
                        <div class="product-options mb-4">
                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted">Color:</label>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-outline-secondary active" data-color="black">Black</button>
                                    <button class="btn btn-outline-secondary" data-color="white">White</button>
                                    <button class="btn btn-outline-secondary" data-color="blue">Blue</button>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label for="quantity" class="form-label fw-bold">Quantity:</label>
                                <div class="input-group" style="width: 150px;">
                                    <button class="btn btn-outline-secondary" type="button" id="decrease-qty">-</button>
                                    <input type="number" class="form-control text-center" value="1" min="1" max="10" id="quantity">
                                    <button class="btn btn-outline-secondary" type="button" id="increase-qty">+</button>
                                </div>
                            </div>
                        </div>

                        <!-- Stock Status -->
                        <div class="stock-status mb-4">
                            <span class="badge bg-success fs-6">
                                <i class="fas fa-check-circle me-1"></i>Còn hàng
                            </span>
                            <span class="text-muted ms-2">Chỉ còn 5 sản phẩm trong kho</span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="action-buttons mb-4">
                            <button class="btn btn-primary btn-lg me-3 add-to-cart" data-product-id="{{ product.id }}">
                                <i class="fas fa-cart-plus me-2"></i>Thêm vào giỏ hàng
                            </button>
                            <button class="btn btn-success btn-lg me-3">
                                <i class="fas fa-bolt me-2"></i>Mua ngay
                            </button>
                            <button class="btn btn-outline-secondary btn-lg wishlist-btn">
                                <i class="far fa-heart"></i>
                            </button>
                        </div>

                        <!-- Shipping Info -->
                        <div class="shipping-info">
                            <div class="card">
                                <div class="card-body">
                                    <h6 class="card-title">Shipping Information</h6>
                                    <ul class="list-unstyled mb-0">
                                        <li><i class="fas fa-truck text-primary me-2"></i>Free shipping on orders over $50</li>
                                        <li><i class="fas fa-clock text-primary me-2"></i>Estimated delivery: 3-5 business days</li>
                                        <li><i class="fas fa-undo text-primary me-2"></i>30-day return policy</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Product Details Tabs -->
    <section class="py-5 bg-light">
        <div class="container">
            <ul class="nav nav-tabs" id="productTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="description-tab" data-bs-toggle="tab" data-bs-target="#description" type="button" role="tab">
                        Description
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="specifications-tab" data-bs-toggle="tab" data-bs-target="#specifications" type="button" role="tab">
                        Specifications
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab">
                        Reviews (24)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="shipping-tab" data-bs-toggle="tab" data-bs-target="#shipping" type="button" role="tab">
                        Shipping & Returns
                    </button>
                </li>
            </ul>
            
            <div class="tab-content bg-white p-4 text-muted" id="productTabsContent">
                <!-- Description Tab -->
                <div class="tab-pane fade show active" id="description" role="tabpanel">
                    <h5>Product Description</h5>
                    <p>{{ product.description }}</p>
                    
                    <h6>Key Features:</h6>
                    <ul>
                        <li><strong>Advanced Noise Cancellation:</strong> Block out unwanted ambient noise for a pure listening experience</li>
                        <li><strong>Extended Battery Life:</strong> Up to 30 hours of continuous playback on a single charge</li>
                        <li><strong>Premium Materials:</strong> Crafted with high-quality materials for durability and comfort</li>
                        <li><strong>Universal Compatibility:</strong> Works seamlessly with all Bluetooth-enabled devices</li>
                        <li><strong>Intuitive Controls:</strong> Easy-to-use touch controls for music and calls</li>
                    </ul>
                    
                    <p>Perfect for commuting, working from home, or simply enjoying your favorite music, these headphones combine style, comfort, and performance in one exceptional package.</p>
                </div>

                <!-- Specifications Tab -->
                <div class="tab-pane fade" id="specifications" role="tabpanel">
                    <h5>Technical Specifications</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Driver Size:</strong></td>
                                    <td>40mm</td>
                                </tr>
                                <tr>
                                    <td><strong>Frequency Response:</strong></td>
                                    <td>20Hz - 20kHz</td>
                                </tr>
                                <tr>
                                    <td><strong>Impedance:</strong></td>
                                    <td>32 Ohms</td>
                                </tr>
                                <tr>
                                    <td><strong>Sensitivity:</strong></td>
                                    <td>110dB</td>
                                </tr>
                                <tr>
                                    <td><strong>Bluetooth Version:</strong></td>
                                    <td>5.0</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <td><strong>Battery Life:</strong></td>
                                    <td>30 hours</td>
                                </tr>
                                <tr>
                                    <td><strong>Charging Time:</strong></td>
                                    <td>2 hours</td>
                                </tr>
                                <tr>
                                    <td><strong>Weight:</strong></td>
                                    <td>250g</td>
                                </tr>
                                <tr>
                                    <td><strong>Dimensions:</strong></td>
                                    <td>190 x 160 x 80mm</td>
                                </tr>
                                <tr>
                                    <td><strong>Warranty:</strong></td>
                                    <td>2 years</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Reviews Tab -->
                <div class="tab-pane fade" id="reviews" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5>Customer Reviews</h5>
                        <button class="btn btn-primary">Write a Review</button>
                    </div>
                    
                    <!-- Review Summary -->
                    <div class="review-summary mb-4 p-3 bg-light rounded">
                        <div class="row align-items-center">
                            <div class="col-md-3 text-center">
                                <div class="h2 mb-0">4.2</div>
                                <div class="text-warning">
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="far fa-star"></i>
                                </div>
                                <div class="text-muted">Based on 24 reviews</div>
                            </div>
                            <div class="col-md-9">
                                <div class="rating-breakdown">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="me-2">5★</span>
                                        <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                            <div class="progress-bar" style="width: 60%"></div>
                                        </div>
                                        <span class="text-muted">60%</span>
                                    </div>
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="me-2">4★</span>
                                        <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                            <div class="progress-bar" style="width: 25%"></div>
                                        </div>
                                        <span class="text-muted">25%</span>
                                    </div>
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="me-2">3★</span>
                                        <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                            <div class="progress-bar" style="width: 10%"></div>
                                        </div>
                                        <span class="text-muted">10%</span>
                                    </div>
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="me-2">2★</span>
                                        <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                            <div class="progress-bar" style="width: 3%"></div>
                                        </div>
                                        <span class="text-muted">3%</span>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <span class="me-2">1★</span>
                                        <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                            <div class="progress-bar" style="width: 2%"></div>
                                        </div>
                                        <span class="text-muted">2%</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Individual Reviews -->
                    <div class="reviews-list">
                        <div class="review-item border-bottom pb-3 mb-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <strong>John D.</strong>
                                    <div class="text-warning">
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                    </div>
                                </div>
                                <small class="text-muted">2 days ago</small>
                            </div>
                            <p>"Excellent sound quality and very comfortable to wear for long periods. The noise cancellation works great!"</p>
                        </div>
                        
                        <div class="review-item border-bottom pb-3 mb-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <strong>Sarah M.</strong>
                                    <div class="text-warning">
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="fas fa-star"></i>
                                        <i class="far fa-star"></i>
                                    </div>
                                </div>
                                <small class="text-muted">1 week ago</small>
                            </div>
                            <p>"Great headphones overall. Battery life is impressive. Only minor complaint is they can get a bit warm during extended use."</p>
                        </div>
                    </div>
                </div>

                <!-- Shipping Tab -->
                <div class="tab-pane fade" id="shipping" role="tabpanel">
                    <h5>Shipping Information</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Shipping Options</h6>
                            <ul>
                                <li><strong>Standard Shipping (Free):</strong> 5-7 business days</li>
                                <li><strong>Express Shipping ($9.99):</strong> 2-3 business days</li>
                                <li><strong>Overnight Shipping ($19.99):</strong> Next business day</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6>Return Policy</h6>
                            <ul>
                                <li>30-day return window</li>
                                <li>Items must be in original condition</li>
                                <li>Free return shipping for defective items</li>
                                <li>Refund processed within 5-7 business days</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Related Products -->
    <section class="py-5">
        <div class="container">
            <h3 class="mb-4">Related Products</h3>
            <div class="row">
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="card product-card h-100 shadow-sm">
                        <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" 
                             class="card-img-top" alt="Smart Watch">
                        <div class="card-body">
                            <h6 class="card-title">Smart Watch</h6>
                            <div class="text-primary fw-bold">$199.99</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="card product-card h-100 shadow-sm">
                        <img src="https://images.unsplash.com/photo-1572635196237-14b3f281503f?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" 
                             class="card-img-top" alt="Sunglasses">
                        <div class="card-body">
                            <h6 class="card-title">Designer Sunglasses</h6>
                            <div class="text-primary fw-bold">$49.99</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="card product-card h-100 shadow-sm">
                        <img src="https://images.unsplash.com/photo-1560472354-b33ff0c44a43?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" 
                             class="card-img-top" alt="Backpack">
                        <div class="card-body">
                            <h6 class="card-title">Travel Backpack</h6>
                            <div class="text-primary fw-bold">$69.99</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="card product-card h-100 shadow-sm">
                        <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" 
                             class="card-img-top" alt="Running Shoes">
                        <div class="card-body">
                            <h6 class="card-title">Running Shoes</h6>
                            <div class="text-primary fw-bold">$79.99</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>


{% endblock %}
