{% extends 'base.html.twig'%}

{% set active_page = 'checkout' %}

{% block title %} Checkout {% endblock %}

{% block body %} 
    <!-- Page Header -->
    <section class="bg-light py-5 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h1 class="display-5 fw-bold mb-3 text-red">Checkout</h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/?action=home">Home</a></li>
                            <li class="breadcrumb-item"><a href="/?action=cart">Cart</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Checkout</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            {% if error is defined %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ error }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endif %}

            <div class="row">
                <!-- Order Summary -->
                <div class="col-lg-5 order-lg-2 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-header bg-dark text-white">
                            <h5 class="mb-0"><i class="fas fa-shopping-bag me-2"></i>Order Summary</h5>
                        </div>
                        <div class="card-body">
                            <!-- Cart Items -->
                            <div class="mb-4">
                                {% for item in cartItems %}
                                <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                                    <div class="d-flex align-items-center">
                                        <img src="{{ item.product.imageUrl ?? '/assets/images/placeholder.jpg' }}" 
                                             alt="{{ item.product.name }}" 
                                             class="rounded me-3" 
                                             style="width: 60px; height: 60px; object-fit: cover;">
                                        <div>
                                            <h6 class="mb-0">{{ item.product.name }}</h6>
                                            <small class="text-muted">Qty: {{ item.quantity }}</small>
                                        </div>
                                    </div>
                                    <span class="fw-bold">${{ (item.product.price * item.quantity)|number_format(2) }}</span>
                                </div>
                                {% endfor %}
                            </div>

                            <!-- Totals -->
                            <div class="border-top pt-3">
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Subtotal</span>
                                    <span>${{ subtotal }}</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Tax (8%)</span>
                                    <span>${{ tax }}</span>
                                </div>
                                <div class="d-flex justify-content-between mb-3">
                                    <span>Shipping</span>
                                    <span>{% if shipping == '0.00' %}Free{% else %}${{ shipping }}{% endif %}</span>
                                </div>
                                <div class="d-flex justify-content-between fw-bold fs-5 border-top pt-3">
                                    <span>Total</span>
                                    <span class="text-primary">${{ total }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Payment Options -->
                <div class="col-lg-7 order-lg-1">
                    <div class="card shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="fas fa-credit-card me-2"></i>Payment</h5>
                        </div>
                        <div class="card-body">
                            <div class="text-center p-4">
                                <h4 class="mb-3">Ready to complete your order?</h4>
                                <p class="text-muted mb-4">Click the button below to process your payment securely.</p>
                                
                                <form action="/?action=process-payment" method="POST" id="paymentForm">
                                    <button type="submit" class="btn btn-success btn-lg w-100 py-3" id="submitBtn">
                                        <i class="fas fa-check-circle me-2"></i>Place Order (${{ total }})
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script>
        // Form submission handler
        document.getElementById('paymentForm').addEventListener('submit', function(e) {
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';
        });
    </script>
{% endblock %}
